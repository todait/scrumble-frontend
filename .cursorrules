#### Animation with Framer Motion

```tsx
import { motion, AnimatePresence } from "framer-motion";

export function ReactionAnimation({ emoji }: { emoji: string }) {
  return (
    <motion.div
      initial={{ scale: 0, opacity: 0 }}
      animate={{ scale: 1, opacity: 1 }}
