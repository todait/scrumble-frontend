### API Integration Patterns

#### Axios Configuration

```typescript
// shared/lib/axios.ts
const apiClient = axios.create({
  baseURL: process.env.NEXT_PUBLIC_API_URL,
  timeout: 10000,
});

// Request interceptor for auth
apiClient.interceptors.request.use((config) => {
  const token = getAuthToken();
  if (token) {
    config.headers.Authorization = `Bearer ${token}`;
  }
  return config;
});

// Response interceptor for error handling
apiClient.interceptors.response.use(
  (response) => response,
  async (error) => {
    if (error.response?.status === 401) {
      await refreshToken();
    }
    return Promise.reject(error);
  }
);
```

#### React Query Configuration

```typescript
// shared/lib/react-query.ts
export const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      staleTime: 1000 * 60 * 5, // 5 minutes
      cacheTime: 1000 * 60 * 10, // 10 minutes
      retry: 1,
      refetchOnWindowFocus: false,
    },
  },
});
```

### WebSocket Integration

```typescript
// features/checkin/hooks/useWebSocket.ts
export function useWebSocket(workspaceId: string) {
  const [socket, setSocket] = useState<WebSocket | null>(null);

  useEffect(() => {
    const ws = new WebSocket(`${WS_URL}/workspace/${workspaceId}`);

    ws.onopen = () => {
      console.log("WebSocket connected");
      setSocket(ws);
    };

    ws.onmessage = (event) => {
      const message = JSON.parse(event.data);
      handleWebSocketMessage(message);
    };

    ws.onerror = (error) => {
      console.error("WebSocket error:", error);
    };

    return () => {
      ws.close();
    };
  }, [workspaceId]);

  const sendMessage = useCallback(
    (message: any) => {
      if (socket?.readyState === WebSocket.OPEN) {
        socket.send(JSON.stringify(message));
      }
    },
    [socket]
  );

  return { socket, sendMessage };
}
```

### Form Handling

```typescript
// features/checkin/components/CheckinForm.tsx
const checkinSchema = z.object({
  conditionScore: z.number().min(1).max(10),
  message: z.string().max(1000),
});

type CheckinFormData = z.infer<typeof checkinSchema>;

export function CheckinForm({ onSubmit }: Props) {
  const { register, handleSubmit, formState: { errors } } = useForm<CheckinFormData>({
    resolver: zodResolver(checkinSchema),
  });

  return (
    <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
      <ConditionSlider {...register('conditionScore')} />
      {errors.conditionScore && (
        <p className="text-red-500 text-sm">{errors.conditionScore.message}</p>
      )}
      {/* Rest of form */}
    </form>
  );
}
```

### Performance Optimization

#### Code Splitting

```typescript
// Lazy load heavy components
const HeavyChart = dynamic(() => import('@/features/analytics/components/Chart'), {
  loading: () => <ChartSkeleton />,
  ssr: false,
});
```

#### Memoization

```typescript
// Memoize expensive computations
const sortedCheckins = useMemo(
  () => checkins.sort((a, b) => b.createdAt - a.createdAt),
  [checkins]
);

// Memoize components when needed
const MemoizedCheckinCard = memo(CheckinCard, (prev, next) => {
  return (
    prev.checkin.id === next.checkin.id &&
    prev.checkin.reactions.length === next.checkin.reactions.length
  );
});
```

### Testing Patterns

```typescript
// features/checkin/components/__tests__/CheckinCard.test.tsx
describe('CheckinCard', () => {
  it('should display user condition and message', () => {
    const checkin = mockCheckin();
    render(<CheckinCard checkin={checkin} onReaction={jest.fn()} />);

    expect(screen.getByText(checkin.message)).toBeInTheDocument();
    expect(screen.getByText(`Feeling: ${checkin.conditionScore}/10`)).toBeInTheDocument();
  });

  it('should call onReaction when emoji is clicked', async () => {
    const onReaction = jest.fn();
    const checkin = mockCheckin();
    render(<CheckinCard checkin={checkin} onReaction={onReaction} />);

    await userEvent.click(screen.getByText('👍'));
    expect(onReaction).toHaveBeenCalledWith('👍');
  });
});
```

